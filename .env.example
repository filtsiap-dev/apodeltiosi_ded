# ---------------------------------------------------------------------------
# .env.example — the SAFE, COMMITTED reference for every configuration
# variable. Copy to .env and fill in real values; .env is git-ignored and is
# loaded automatically by every entry point (CLI, HTTP API, gunicorn) via
# anonymizer.config.load_env_file. A variable already set in the real process
# environment always wins over the file. NEVER put real secrets in THIS file.
# ---------------------------------------------------------------------------

# LLM provider selection: "openai" or "azure".
ANON_PROVIDER=openai

# --- Required when ANON_PROVIDER=openai ------------------------------------
OPENAI_API_KEY=sk-replace-with-your-openai-key
ANON_MODEL=your-openai-model-name

# --- Required when ANON_PROVIDER=azure -------------------------------------
# AZURE_OPENAI_API_KEY=replace-with-your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# ANON_AZURE_DEPLOYMENT=your-azure-deployment-name
# ANON_AZURE_API_VERSION=2024-02-15-preview

# --- Required to serve the HTTP API ----------------------------------------
# Bearer credential for POST /anonymize. Callers must send
#   Authorization: Bearer <ANON_API_KEY>
# The HTTP service REFUSES TO START when this is unset, so /anonymize is never
# exposed unauthenticated. The CLI does not use it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANON_API_KEY=replace-with-a-long-random-value

# --- Optional tuning knobs (defaults shown) --------------------------------
ANON_LLM_TIMEOUT_S=60
ANON_CHUNK_SIZE_CHARS=3000
ANON_MAX_COMPLETION_TOKENS=3000
# How many document chunks are sent to the LLM in parallel (each chunk still
# runs its two passes in order). Lower this if you hit 429 rate limits.
ANON_LLM_CONCURRENCY=8
ANON_LOG_LEVEL=INFO

# Maximum end-to-end processing time for ONE document, in seconds. Covers
# the upload, validation, both LLM passes, every retry and every sleep. A
# document that exceeds it is answered with HTTP 504 and no file is
# produced.
ANON_DOCUMENT_DEADLINE_S=300

# --- Resource limits (defaults shown) --------------------------------------
# Finite bounds on one document. See anonymizer/limits.py for what each one
# closes; the defaults are calibrated against a real Greek decision (166 KB on
# the wire, 23 ZIP members, 1.1 MB expanded, 38k characters, 19 chunks) and
# leave it between eight and sixty times of headroom.
#
# Exceeding any of them is an HTTP 413.
ANON_MAX_UPLOAD_BYTES=20000000
ANON_MAX_ZIP_MEMBERS=500
ANON_MAX_ZIP_MEMBER_BYTES=25000000
ANON_MAX_ZIP_TOTAL_BYTES=60000000
ANON_MAX_COMPRESSION_RATIO=50
ANON_COMPRESSION_RATIO_FLOOR_BYTES=1000000
ANON_MAX_TEXT_CHARS=400000
ANON_MAX_CHUNKS=150

# --- Consumed by gunicorn.conf.py, not the application ---------------------
ANON_HOST=0.0.0.0
ANON_PORT=8000
WEB_CONCURRENCY=2
ANON_GUNICORN_TIMEOUT=900
ANON_GRACEFUL_TIMEOUT=900
