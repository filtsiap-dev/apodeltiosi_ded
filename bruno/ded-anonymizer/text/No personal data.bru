meta {
  name: No personal data
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/anonymize-text
  body: text
  auth: bearer
}

headers {
  Content-Type: text/plain; charset=utf-8
}

auth:bearer {
  token: {{apiKey}}
}

body:text {
  έχω 3 παιδια τι επιδομα θα παρω?
}

tests {
  test("the text comes back unchanged", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.equal("έχω 3 παιδια τι επιδομα θα παρω?");
    expect(res.getHeader("x-redaction-counts")).to.equal("none");
  });
}
