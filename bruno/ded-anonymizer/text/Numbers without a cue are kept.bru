meta {
  name: Numbers without a cue are kept
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/anonymize-text
  body: text
  auth: bearer
}

headers {
  Content-Type: text/plain; charset=utf-8
}

auth:bearer {
  token: {{apiKey}}
}

body:text {
  Το 2020 πλήρωσα 1500 ευρώ, στις 10:30, για 3 παιδιά.
}

tests {
  test("years, amounts, times and counts stay visible", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.include("Το 2020 πλήρωσα 1500 ευρώ, στις 10:30, για 3 παιδιά.");
  });
  test("nothing is counted", function() {
    expect(res.getHeader("x-anonymization-status")).to.equal("anonymized");
    expect(res.getHeader("x-redaction-counts")).to.equal("none");
  });
}

docs {
  A number is masked for its cue only when an ID's name comes before it. With no cue word, years, amounts,
  times and counts are kept.
}
