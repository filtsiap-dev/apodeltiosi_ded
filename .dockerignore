# Secrets never go into the image — inject them as environment variables.
.env

# Build/runtime artifacts.
__pycache__/
*.pyc
ded_anonymizer.egg-info/

# The CLI stays out of the image — the container is API-only.
run_anonymizer.py

# Docs and reports not needed at runtime.
BUILDER_REPORT.md
CODEBASE_GUIDE.md
README.md

# Docker files themselves.
Dockerfile
docker-compose.yml
.dockerignore
.gitignore
